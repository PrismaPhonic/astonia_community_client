FROM cachyos/cachyos:latest

# Minimal Windows build environment with Clang
# Use this for CI/CD and production builds

# Upgrade system with auto-resolve enabled
# Use --needed to skip already-installed packages and avoid 404 errors on old versions
RUN pacman -Syyu --noconfirm --needed --ask=4 --overwrite="*"

# Configure MSYS2 clang64 repository
RUN printf '\n[clang64]\nSigLevel = Optional TrustAll\nServer = https://mirror.msys2.org/mingw/clang64\n' >> /etc/pacman.conf

RUN pacman-key --init && pacman -Sy --noconfirm

# Install minimal build essentials
RUN pacman -S --noconfirm --needed --ask=4 --overwrite="*" \
    base-devel \
    make \
    clang \
    lld \
    zip \
    && pacman -Scc --noconfirm

# Install Clang Windows cross-compilation toolchain
RUN pacman -S --noconfirm --needed --ask=4 --overwrite="*" \
    mingw-w64-clang-x86_64-clang \
    mingw-w64-clang-x86_64-lld \
    mingw-w64-clang-x86_64-compiler-rt \
    mingw-w64-binutils \
    && pacman -Scc --noconfirm

# Install required libraries
RUN pacman -S --noconfirm --needed --ask=4 --overwrite="*" \
    mingw-w64-clang-x86_64-sdl3 \
    mingw-w64-clang-x86_64-zlib \
    mingw-w64-clang-x86_64-libpng \
    mingw-w64-clang-x86_64-libzip \
    mingw-w64-clang-x86_64-dwarfstack \
    mingw-w64-clang-x86_64-mimalloc \
    unzip \
    && pacman -Scc --noconfirm

# Install vendored SDL3_mixer (not yet available in MSYS2 repos)
COPY vendored/SDL3_mixer-mingw64.zip /tmp/
RUN cd /tmp && \
    unzip -q SDL3_mixer-mingw64.zip && \
    tar -xzf SDL3_mixer-3.1.0-windows-mingw-x64.tar.gz && \
    cd SDL3_mixer-3.1.0-windows-mingw-x64 && \
    cp -r include/SDL3_mixer /clang64/include/ && \
    cp lib/libSDL3_mixer.dll.a /clang64/lib/ && \
    cp bin/SDL3_mixer.dll /clang64/bin/ && \
    cp lib/pkgconfig/sdl3-mixer.pc /clang64/lib/pkgconfig/ && \
    cd / && \
    rm -rf /tmp/SDL3_mixer*

ENV USER=root \
    HOME=/root \
    CARGO_HOME=/root/.cargo \
    RUSTUP_HOME=/root/.rustup

# Install Rust for astonia_net component
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable
ENV PATH="/root/.cargo/bin:${PATH}"
RUN rustup target add x86_64-pc-windows-gnullvm

# Container-local Cargo config for Windows cross-compilation
RUN mkdir -p /root/.cargo && \
    printf '%s\n' \
'[target.x86_64-pc-windows-gnullvm]' \
'linker = "clang"' \
'rustflags = [' \
'  "-C", "link-arg=--target=x86_64-w64-mingw32",' \
'  "-C", "link-arg=--sysroot=/clang64",' \
'  "-C", "link-arg=-fuse-ld=lld",' \
'  "-C", "link-arg=--rtlib=compiler-rt",' \
'  "-C", "link-arg=-resource-dir=/clang64/lib/clang/21",' \
'  "-C", "link-arg=-L/clang64/lib",' \
']' \
    > /root/.cargo/config.toml

# Set build environment variables - toolchain configuration only
# Project-specific flags are in Makefile.windows
ENV CC="clang" \
    CXX="clang++" \
    AR="llvm-ar" \
    RANLIB="llvm-ranlib" \
    TARGET="x86_64-w64-mingw32" \
    SYSROOT="/clang64" \
    WIN32_WINNT="0x0601" \
    WINDRES="x86_64-w64-mingw32-windres --preprocessor=clang --preprocessor-arg=--target=x86_64-w64-mingw32 --preprocessor-arg=-E --preprocessor-arg=-xc --preprocessor-arg=-DRC_INVOKED"

WORKDIR /app
ENTRYPOINT ["make", "-f", "build/make/Makefile.windows"]
